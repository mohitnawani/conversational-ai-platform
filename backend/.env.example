# Copy this file to .env and fill in real values.

# Required — Gemini API key for the LLM (chat, entity/KG extraction, summaries)
GOOGLE_API_KEY=

# SQLite (dev) or Postgres (prod), e.g.
# postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///memory.db

# Random long secret used to sign JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Set to true in production (requires HTTPS)
JWT_COOKIE_SECURE=false

# Comma-separated list of allowed browser origins (the frontend's URL)
CORS_ORIGINS=http://localhost:5173

# Redis for the logout token blocklist.
# The backend degrades gracefully if Redis is down.
REDIS_URL=redis://localhost:6379/0

# Optional gunicorn tuning (used by gunicorn.conf.py)
# GUNICORN_THREADS=8
# GUNICORN_TIMEOUT=120